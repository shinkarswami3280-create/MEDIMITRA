# ============================================================
# MediMitra — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# JWT Auth — CHANGE SECRET_KEY before any real deployment
SECRET_KEY=medimitra-demo-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database — SQLite for demo, swap for Postgres in production
# SQLite:   sqlite:///./medimitra.db
# Postgres: postgresql://user:password@host:5432/medimitra
DATABASE_URL=sqlite:///./medimitra.db

# App Environment
APP_ENV=development
DEMO_MODE=true

# Port (Cloud Run sets $PORT automatically)
PORT=8000

# ============================================================
# OPTIONAL — Twilio (WhatsApp + Voice)
# Leave blank to use the fully-functional simulated fallback.
# ============================================================
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# TWILIO_VOICE_NUMBER=+1xxxxxxxxxx
# TWILIO_WEBHOOK_BASE_URL=https://your-cloud-run-url.run.app

# ============================================================
# OPTIONAL — Google Sheets export via gspread
# Leave blank to skip Sheets; CSV export always works.
# ============================================================
# GOOGLE_SHEETS_CREDENTIALS_JSON=/path/to/service-account.json
# GOOGLE_SHEETS_SPREADSHEET_ID=

# ============================================================
# CORS — Comma-separated allowed origins
# ============================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
